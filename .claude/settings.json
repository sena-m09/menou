{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(pnpm test:floor)"],
    "deny": ["Edit(~/.claude/**)", "Edit(~/.codex/**)"]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": ["pnpm test:floor", "gh *", "git *"],
    "network": { "allowedDomains": ["registry.npmjs.org"] }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm -s --dir \"$CLAUDE_PROJECT_DIR\" build >/dev/null 2>&1; \"$CLAUDE_PROJECT_DIR/bin/menou\" hook session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm -s --dir \"$CLAUDE_PROJECT_DIR\" build >/dev/null 2>&1; \"$CLAUDE_PROJECT_DIR/bin/menou\" hook stop"
          }
        ]
      }
    ]
  }
}
