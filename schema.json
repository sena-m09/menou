{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "エディタ補完用の JSON Schema の URL"
    },
    "maxBlocks": {
      "type": "integer",
      "minimum": 1,
      "description": "1 つの依頼の中で、続けてブロックできる回数。達したら完了を許可して人に知らせる",
      "default": 3
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "description": "一意な識別子。menou run <id> で使う。英小文字・数字・-・_ で書く"
          },
          "mode": {
            "enum": [
              "inline",
              "evidence"
            ],
            "type": "string",
            "description": "実行方式"
          },
          "run": {
            "type": "string",
            "minLength": 1,
            "description": "実行するシェルコマンド。終了コード 0 / 1 / その他で合格 / 不合格 / エラー"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "対象範囲（git の pathspec）。範囲内が変わったときだけ要求する。全ファイルなら [\"**\"]"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "前提となるチェックの id。前提が通るまで実行も判定もしない"
          },
          "severity": {
            "enum": [
              "block",
              "warn"
            ],
            "type": "string",
            "description": "warn は警告を出すだけで完了を許可する",
            "default": "block"
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "description": "inline 方式でのタイムアウト（秒）。時間切れはエラーとして扱う",
            "default": 120
          },
          "hint": {
            "type": "string",
            "maxLength": 200,
            "description": "不足時の理由文に添える補足。200 文字まで。長い案内は別のファイルに書き、その場所を書く"
          }
        },
        "required": [
          "id",
          "mode",
          "run",
          "paths"
        ],
        "additionalProperties": false
      },
      "description": "チェック定義の配列"
    }
  },
  "required": [
    "checks"
  ],
  "additionalProperties": false,
  "title": "menou の設定（.menou.json）",
  "$schema": "http://json-schema.org/draft-07/schema#"
}
